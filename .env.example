# ========================================================
# 🔐 CONFIGURACIÓN DEL DASHBOARD HUB & BASE DE DATOS
# ========================================================

# 1. Base de datos Relacional (PostgreSQL)
# Ejemplos:
# - Supabase / Neon / Railway: postgresql://postgres:password@db.xxxxxx.supabase.co:5432/postgres?sslmode=require
# - Local Docker / Servidor: postgresql://postgres:password@localhost:5432/hub_dashboard?sslmode=disable
# (Si dejas DATABASE_URL vacío, el dashboard utilizará el almacenamiento local seguro en /data)
DATABASE_URL=postgresql://postgres:password@localhost:5432/hub_dashboard?sslmode=disable

# 2. Seguridad de Autenticación & JWT
JWT_SECRET=super-secret-hub-session-key-change-in-production-123456789!

# 3. Credenciales de Administrador (Opcionales para primer inicio automático)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword

# 4. Puerto de la aplicación (Por defecto 3000)
PORT=3000
